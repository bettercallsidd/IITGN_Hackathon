DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=long-random-string
GOOGLE_CLIENT_ID=
PORT=3000

# --- Admin dashboard (/admin) ---
# Create the first owner:  npm run admin:create -- you@example.com owner
ANTHROPIC_API_KEY=           # optional: enables Claude insights; without it a rule-based proposer is used
ANTHROPIC_MODEL=claude-sonnet-5-5
ADMIN_REQUIRE_2FA=1          # set 0 only for local testing
ADMIN_IP_ALLOWLIST=          # optional, comma-separated IPs allowed to reach /admin
TRUST_PROXY=0                # set 1 behind a reverse proxy (needed for correct client IPs)
NODE_ENV=development         # production => Secure cookies + HSTS
